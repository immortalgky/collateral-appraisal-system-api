@page
@model Auth.Pages.Account.Login
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="@Model.Lang">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="initial-scale=1, width=device-width">

    <link rel="stylesheet" href="/Assets/index.css?v=@Login.AssetVersion"/>

    <title>@Model.T.Title</title>
</head>

<body>
<div class="login login--signin">
    <div class="login-image">
        <img src="/Assets/Bangkok skyline view.png" alt="Bangkok skyline">
    </div>
    <div class="login-panel">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" value="@Model.ReturnUrl"/>

            <partial name="_IdpHeader" model="Model" />
            <h1 class="login-title">@Model.T.Heading</h1>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="error-message">@Model.Error</div>
            }

            <div class="input-container">
                <label class="input-label" for="name">@Model.T.UsernameLabel</label>
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    <input class="text-input" type="text" id="name" name="Username" value="@Model.Username"
                           placeholder="@Model.T.UsernamePlaceholder" autocomplete="username" required>
                </div>
            </div>

            <div class="input-container">
                <label class="input-label" for="password">@Model.T.PasswordLabel</label>
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    <input class="text-input" type="password" id="password" name="Password"
                           placeholder="@Model.T.PasswordPlaceholder" autocomplete="current-password" required>
                    <button type="button" class="eye-toggle" onclick="togglePassword()"
                            aria-label="@Model.T.TogglePassword">
                        <svg class="eye-icon eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        <svg class="eye-icon eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" style="display:none;">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                            <path d="M1 1l22 22"/>
                            <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="login-button-container">
                <button type="submit" class="login-button">@Model.T.SignIn</button>
            </div>
            @if (Model.HasSpaLogin)
            {
                <a class="login-back" href="@Model.SpaLoginUrl">@Model.T.ChooseOtherMethod</a>
            }
        </form>
    </div>
</div>
<script>
    function togglePassword() {
        var input = document.getElementById('password');
        var open = document.querySelector('.eye-open');
        var closed = document.querySelector('.eye-closed');
        if (input.type === 'password') {
            input.type = 'text';
            open.style.display = 'none';
            closed.style.display = 'block';
        } else {
            input.type = 'password';
            open.style.display = 'block';
            closed.style.display = 'none';
        }
    }

    // The cookie is shared with the SPA (same host, any port), so it is not HttpOnly. Navigate with an
    // explicit GET to the same URL (keeps ReturnUrl and the authorize query): reload() would re-POST the
    // credentials after a failed attempt.
    function setLanguage(lang) {
        // Secure: every environment is served over https (the SPA reads the cookie from its own https origin).
        document.cookie = 'cas-lang=' + lang + '; Path=/; SameSite=Lax; Secure; Max-Age=31536000';
        var username = document.getElementById('name').value;
        // sessionStorage can throw (blocked storage, private modes); the language switch must still happen.
        var url = location.pathname + location.search;
        // Saved even when empty: the user cleared a prefilled field, and the reload must not bring it back.
        try { sessionStorage.setItem('login-username', JSON.stringify({ url: url, username: username })); } catch (e) { }
        location.replace(url);
    }

    // Close the language menu on Escape (focus returns to its summary) and on a click outside it.
    var langMenu = document.querySelector('.login-lang');
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && langMenu.open) {
            langMenu.open = false;
            langMenu.querySelector('summary').focus();
        }
    });
    document.addEventListener('click', function (e) {
        if (!langMenu.contains(e.target)) langMenu.open = false;
    });

    (function () {
        try {
            // Only the page we switched language on gets the username back, and it is read once: a stale
            // value must never prefill someone else's later sign-in. It wins, even when empty, over the
            // server's login_hint prefill: it is what the user had in the field.
            var saved = JSON.parse(sessionStorage.getItem('login-username') || 'null');
            sessionStorage.removeItem('login-username');
            var input = document.getElementById('name');
            if (saved && saved.url === location.pathname + location.search) input.value = saved.username;
        } catch (e) { }
    })();

    document.querySelector('form').addEventListener('submit', function () {
        var btn = document.querySelector('.login-button');
        btn.disabled = true;
        btn.textContent = @Json.Serialize(Model.T.SigningIn);
        btn.classList.add('loading');
    });
</script>
</body>

</html>
