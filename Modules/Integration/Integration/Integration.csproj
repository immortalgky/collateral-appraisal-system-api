<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Integration.Module</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <!-- Provides the IHealthCheck / IHealthChecksBuilder types used by SftpHealthCheck. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <!-- Explicit: SftpFileSink uses Renci.SshNet directly (don't rely on the transitive ref via Shared). -->
        <PackageReference Include="SSH.NET" />
        <!-- Explicit: RegulatoryExcelWriter builds the xlsx companion with ClosedXML. -->
        <PackageReference Include="ClosedXML" />
        <!-- Explicit: FailedMessageCollectorService talks to RabbitMQ directly (its own connection,
             never MassTransit's) to drain _error/_skipped queues and republish retries. -->
        <PackageReference Include="RabbitMQ.Client" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../Shared/Shared/Shared.csproj"/>
        <ProjectReference Include="../../../Shared/Shared.Messaging/Shared.Messaging.csproj"/>
        <ProjectReference Include="../Integration.Contracts/Integration.Contracts.csproj"/>
        <ProjectReference Include="../../Request/Request/Request.csproj"/>
        <ProjectReference Include="../../Workflow/Workflow.Contracts/Workflow.Contracts.csproj"/>
        <ProjectReference Include="../../Document/Document/Document.csproj"/>
        <ProjectReference Include="../../Appraisal/Appraisal/Appraisal.csproj"/>
        <ProjectReference Include="../../Collateral/Collateral.Contracts/Collateral.Contracts.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Application\Features\AppraisalRequests\ResubmitRequest\"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Tests/Integration/Integration.csproj (assembly name "Integration", NOT this module's
             "Integration.Module") exercises the collector's internal RunRoundAsync overload directly. -->
        <InternalsVisibleTo Include="Integration"/>
        <!-- Tests/Unit/Integration.Tests/Integration.Tests.csproj (assembly name "Integration.Tests")
             exercises BuildUnparseableEntity/AlreadyCollectedAsync directly (S2 dedup-by-existence-check
             follow-up) without needing a broker or Testcontainers database. -->
        <InternalsVisibleTo Include="Integration.Tests"/>
    </ItemGroup>

</Project>
