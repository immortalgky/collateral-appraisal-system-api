{
  "ConnectionStrings": {
    "Database": "Server=localhost;Database=<Database>;User Id=<User Id>;Password=<Password>;TrustServerCertificate=True;",
    "Redis": "localhost:6379",
    "Hangfire": "Server=localhost;Database=<Database>;User Id=<User Id>;Password=<Password>;TrustServerCertificate=True;"
  },
  "RabbitMQ": {
    "Host": "amqp://localhost:5672/",
    "Username": "<RABBITMQ_USERNAME>",
    "Password": "<RABBITMQ_PASSWORD>",
    "ManagementUrl": "http://localhost:15672"
  },
  "FailedMessages": {
    "Enabled": true,
    "Interval": "00:00:15",
    "BatchPerQueue": 100
  },
  "OAuth2": {
    "SigningCertificate": {
      "Source": "store",
      "StoreName": "My",
      "StoreLocation": "LocalMachine",
      "Thumbprint": "<SIGNING_CERT_THUMBPRINT>"
    },
    "EncryptionCertificate": {
      "Source": "store",
      "StoreName": "My",
      "StoreLocation": "LocalMachine",
      "Thumbprint": "<ENCRYPTION_CERT_THUMBPRINT>"
    }
  },
  "SeedData": {
    "RunSeeders": false,
    "IncludeDemoData": false,
    "AdminUser": {
      "Username": "<ADMIN_USERNAME>",
      "Password": "<ADMIN_PASSWORD>"
    }
  },
  "Serilog": {
    // Using/WriteTo are keyed objects, not arrays — Microsoft.Extensions.Configuration otherwise
    // merges arrays element-by-index across appsettings.{Environment}.json, so an environment
    // file adding its own sink at "index 1" silently overwrote whatever this base file had at
    // that index instead of adding a new one. Named keys make each environment's additions a
    // plain union with these base entries. This file (loaded in every environment) writes to the
    // database only; appsettings.Development.json/Production.json.template add their own sinks
    // under new keys.
    "Using": {
      "Database": "Serilog.Sinks.MSSqlServer"
    },
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "MassTransit": "Warning",
        "Hangfire": "Warning",
        "OpenIddict": "Warning",
        "Microsoft.AspNetCore.HttpLogging": "Information"
      }
    },
    "WriteTo": {
      "Database": {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Database",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "schemaName": "dbo",
            "autoCreateSqlTable": false,
            "batchPostingLimit": 200,
            "period": "0.00:00:05"
          },
          "restrictedToMinimumLevel": "Information",
          "columnOptionsSection": {
            "disableTriggers": true,
            "addStandardColumns": [ "LogEvent" ],
            "removeStandardColumns": [ "Properties" ],
            "timeStamp": { "columnName": "TimeStamp", "convertToUtc": false },
            "logEvent": { "columnName": "Properties", "excludeStandardColumns": true },
            "additionalColumns": [
              { "ColumnName": "CorrelationId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "EntityId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "AppraisalId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "RequestId", "DataType": "nvarchar", "DataLength": 64, "PropertyName": "CasRequestId" },
              { "ColumnName": "WorkflowInstanceId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "CollateralId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "DocumentId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "MachineName", "DataType": "nvarchar", "DataLength": 128 },
              { "ColumnName": "UserName", "DataType": "nvarchar", "DataLength": 128 },
              { "ColumnName": "SourceContext", "DataType": "nvarchar", "DataLength": 256 },
              { "ColumnName": "RequestPath", "DataType": "nvarchar", "DataLength": 400 }
            ]
          }
        }
      }
    },
    // WithMachineName/WithProcessId/WithThreadId used to be listed here but never actually ran —
    // no Serilog.Enrichers.Environment/Process/Thread package is referenced anywhere in the
    // solution, so Serilog.Settings.Configuration silently failed to resolve them (visible only
    // via SelfLog). MachineName is now added in code (Program.cs, next to HttpUserEnricher).
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "CollateralAppraisalSystem"
    }
  },
  "Ldap": {
    "Enabled": false,
    "Server": "LHB.NET",
    "Port": 389,
    "UseSsl": false,
    "UseIntegratedAuth": true,
    "Domain": "LHB",
    "BaseDn": "DC=LHB,DC=NET",
    "BindDn": "",
    "BindPassword": "",
    "SearchFilter": "(sAMAccountName={0})",
    "ConnectionTimeoutSeconds": 5,
    "Attributes": {
      "Username": "sAMAccountName",
      "Email": "mail",
      "FirstName": "givenName",
      "LastName": "sn",
      "Department": "department",
      "Position": "title"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AppBaseUrl": "<APP_BASE_URL>",
  "Observability": {
    "Enabled": true,
    "ServiceName": "CollateralAppraisalSystem",
    "ServiceVersion": "1.0.0",
    "Tracing": {
      "OtlpEndpoint": null
    }
  },
  "Workflow": {
    "AcknowledgementGroupByCommitteeCode": {
      "SUB_COMMITTEE": "1",
      "COMMITTEE": "2"
    }
  },
  "SignalR": {
    "UseRedisBackplane": true,
    "ChannelPrefix": "cas"
  },
  "AllowedHosts": "*",
  "TimeZone": {
    "DefaultTimeZone": "Asia/Bangkok",
    "ForceUtc": false,
    "Culture": "en-US",
    "DateFormat": "yyyy-MM-dd",
    "TimeFormat": "HH:mm:ss",
    "DateTimeFormat": "yyyy-MM-dd HH:mm:ss"
  },
  "FileStorage": {
    "Mode": "Local",
    "NasBasePath": "\\\\nas_app_dev\\CAS",
    "RootPath": "uploads",
    "TempPath": "temp",
    "DocumentsPath": "documents",
    "ArchivePath": "archive",
    "DeletedPath": "deleted",
    "MaxFileSizeBytes": 52428800,
    "MaxFilesPerSession": 20,
    "MaxTotalSessionSizeBytes": 209715200,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".tif",
      ".tiff"
