{
  // Secret VALUES below (connection-string passwords, RabbitMQ/Mail/SFTP/admin passwords) must
  // be encrypted as "ENC:v1:..." using CasSecretTool on the app server. The app decrypts them at
  // startup with the certificate whose thumbprint is in Secrets:CertificateThumbprint. See
  // docs/deployment/multi-server-deployment.md. Non-secret values stay plaintext.
  "Secrets": {
    "CertificateThumbprint": "#{SECRETS_CERT_THUMBPRINT}#"
  },
  "ConnectionStrings": {
    // Encrypt the whole connection string (it contains Password=...). Or, preferred long-term,
    // use Integrated Security and a domain service-account AppPool so there is no password at all.
    "Database": "#{DATABASE_CONNECTION_STRING}#",
    "Redis": "#{REDIS_CONNECTION_STRING}#",
    "Hangfire": "#{HANGFIRE_CONNECTION_STRING}#"
  },
  "RabbitMQ": {
    "Host": "#{RABBITMQ_HOST}#",
    "Username": "#{RABBITMQ_USERNAME}#",
    "Password": "#{RABBITMQ_PASSWORD}#"
  },
  "OAuth2": {
    "SigningCertificate": {
      "Source": "store",
      "StoreName": "My",
      "StoreLocation": "LocalMachine",
      "Thumbprint": "#{OAUTH2_SIGNING_CERT_THUMBPRINT}#"
    },
    "EncryptionCertificate": {
      "Source": "store",
      "StoreName": "My",
      "StoreLocation": "LocalMachine",
      "Thumbprint": "#{OAUTH2_ENCRYPTION_CERT_THUMBPRINT}#"
    }
  },
  "AppBaseUrl": "#{APP_BASE_URL}#",
  "Auth": {
    "InternalAuthBaseUrl": "#{AUTH_INTERNAL_BASE_URL}#"
  },
  // Self-contained: production runs on this file alone, so every Serilog setting lives here, not
  // inherited from appsettings.json. Keys match the base file ("Database", "File"), so if the base
  // file is ever loaded too, these override it one-to-one instead of adding a second sink. Keep
  // columnOptionsSection in step with appsettings.json and the dbo.Logs migration.
  "Serilog": {
    "Using": {
      "Database": "Serilog.Sinks.MSSqlServer",
      "File": "Serilog.Sinks.File"
    },
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "MassTransit": "Warning",
        "Hangfire": "Warning",
        "OpenIddict": "Warning",
        // The inbound /api/v1 and /api/v2 request/response line (Program.cs UseHttpLogging).
        "Microsoft.AspNetCore.HttpLogging": "Information",
        // Dev keeps seeing these to fix the underlying issue; prod only wants the row.
        "Microsoft.EntityFrameworkCore.Model.Validation": "Error"
      }
    },
    "WriteTo": {
      "Database": {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Database",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "schemaName": "dbo",
            "autoCreateSqlTable": false,
            "batchPostingLimit": 200,
            "period": "0.00:00:05"
          },
          "restrictedToMinimumLevel": "Information",
          "columnOptionsSection": {
            "disableTriggers": true,
            "addStandardColumns": [ "LogEvent" ],
            "removeStandardColumns": [ "Properties" ],
            "timeStamp": { "columnName": "TimeStamp", "convertToUtc": false },
            "logEvent": { "columnName": "Properties", "excludeStandardColumns": true },
            "additionalColumns": [
              { "ColumnName": "CorrelationId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "EntityId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "AppraisalId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "RequestId", "DataType": "nvarchar", "DataLength": 64, "PropertyName": "CasRequestId" },
              { "ColumnName": "WorkflowInstanceId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "CollateralId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "DocumentId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "MachineName", "DataType": "nvarchar", "DataLength": 128 },
              { "ColumnName": "UserName", "DataType": "nvarchar", "DataLength": 128 },
              { "ColumnName": "SourceContext", "DataType": "nvarchar", "DataLength": 256 },
              { "ColumnName": "RequestPath", "DataType": "nvarchar", "DataLength": 400 }
            ]
          }
        }
      },
      // restrictedToMinimumLevel: Warning — the file is the fallback for when the DB sink is down,
      // not a mirror of it. Information includes the HTTP request/response logging line, whose body
      // can carry customer PII (see Program.cs); keeping that off server disk and only ever in the
      // access-controlled dbo.Logs table (LOGS_VIEW permission) was a deliberate call, not an oversight.
      "File": {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "restrictedToMinimumLevel": "Warning",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    },
    // MachineName and UserName are added in code (Program.cs); the WithMachineName/WithProcessId/
    // WithThreadId/WithEnvironmentName enrichers have no package and never resolved.
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Collateral Appraisal System",
      "Environment": "Production"
    }
  },
  "AllowedHosts": "#{ALLOWED_HOSTS}#",
  "SignalR": {
    "UseRedisBackplane": true,
    "ChannelPrefix": "cas-prod"
  },
  // Thai local time, not UTC: dbo.Logs.TimeStamp is written server-local by Serilog
  // (convertToUtc: false), so ApplicationNow must stay on the server's clock.
  "TimeZone": {
    "DefaultTimeZone": "Asia/Bangkok",
    "ForceUtc": false,
    "Culture": "en-US",
    "DateFormat": "yyyy-MM-dd",
    "TimeFormat": "HH:mm:ss",
    "DateTimeFormat": "yyyy-MM-dd HH:mm:ss"
  },
  // No Tracing:OtlpEndpoint — tracing stays off. There is no OTLP collector in
  // any environment (see project_no_external_observability_stack); the #{OTLP_ENDPOINT}# deploy
  // token is retired, not just unused here — remove it from the deploy pipeline's token list too.
  "Observability": {
    "Enabled": true,
    "ServiceName": "CollateralAppraisalSystem",
    "ServiceVersion": "#{SERVICE_VERSION}#"
  },
  "WorkflowResilience": {
    "Retry": {
      "MaxRetryAttempts": 5,
      "BaseDelay": "00:00:02",
      "MaxDelay": "00:01:00"
    },
    "Timeout": {
      "DatabaseOperation": "00:01:00",
      "ExternalHttpCall": "00:00:30",
      "ActivityExecution": "00:10:00"
    },
    "CircuitBreaker": {
      "MinimumThroughput": 50,
      "BreakDuration": "00:01:00"
    }
  },
  "HealthChecks": {
    "AllowCachingResponses": false,
    "CacheDuration": "00:00:30"
  },
  "Cors": {
    "AllowedOrigins": [ "#{FRONTEND_ORIGIN}#" ]
  },
  "Ldap": {
    "Enabled": true,
    "Server": "LHB.NET",
    "Port": 389,
    "UseSsl": false,
    "UseIntegratedAuth": true,
    "Domain": "LHB",
    "BaseDn": "DC=LHB,DC=NET",
    "BindDn": "",
    "BindPassword": "",
    "SearchFilter": "(sAMAccountName={0})",
    "ConnectionTimeoutSeconds": 5,
    "Attributes": {
      "Username": "sAMAccountName",
      "Email": "mail",
      "FirstName": "givenName",
      "LastName": "sn",
      "Department": "department",
      "Position": "title"
    }
  },
  "FileStorage": {
    "Mode": "Nas",
    "NasBasePath": "#{FILESTORAGE_NAS_PATH}#",
    "RootPath": "uploads",
    "TempPath": "temp",
    "DocumentsPath": "documents",
    "ArchivePath": "archive",
    "DeletedPath": "deleted",
    "MaxFileSizeBytes": 52428800,
    "MaxFilesPerSession": 20,
    "MaxTotalSessionSizeBytes": 209715200,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".tif",
      ".tiff"
    ],
    "ImageVariants": {
      "GenerateThumbnails": true,
      "Sizes": {
        "Small": { "Width": 150, "Height": 150 },
        "Medium": { "Width": 300, "Height": 300 },
        "Large": { "Width": 800, "Height": 600 }
      }
    },
    "Cleanup": {
      "TempSessionExpirationHours": 24,
      "DeletedRetentionDays": 30,
      "OrphanedCheckDays": 7
    },
    "Archive": {
      "ArchiveAfterDays": 365,
      "AutoArchiveEnabled": true
    }
  },
  "Reporting": {
    "ChromiumExecutablePath": "#{CHROMIUM_PATH}#",
    "MaxConcurrentPages": 4,
    "ReportsSubfolder": "reports",
    "ArtifactRetentionDays": 7
  },
  "BackgroundJobs": {
    "OutboxDelivery": { "PollInterval": "00:00:05", "BatchSize": 50, "MaxRetries": 5, "LeaseDuration": "00:00:30" },
    "SlaMonitor": { "LeaseDuration": "00:03:00", "WorkInterval": "00:01:00", "StandbyPollInterval": "00:00:05" },
    "QuotationAutoClose": { "LeaseDuration": "00:03:00", "WorkInterval": "00:01:00", "StandbyPollInterval": "00:00:05" },
    "TaskLockExpiry": { "Interval": "00:05:00", "LockTimeout": "00:30:00" }
  },
  "SeedData": {
    "RunSeeders": false,
    "IncludeDemoData": false,
    "AdminUser": {
      "Username": "#{ADMIN_USERNAME}#",
      "Password": "#{ADMIN_PASSWORD}#"
    }
  },
  "Authentication": {
    "Clients": {
      "los": { "ClientSecret": "#{LOS_CLIENT_SECRET}#" },
      "cls": { "ClientSecret": "#{CLS_CLIENT_SECRET}#" }
    }
  },
  "Mail": {
    "Host": "#{MAIL_HOST}#",
    "Port": 587,
    "UseStartTls": true,
    "Username": "#{MAIL_USERNAME}#",
    "Password": "#{MAIL_PASSWORD}#",
    "FromAddress": "#{MAIL_FROM_ADDRESS}#",
    "FromDisplayName": "Collateral Appraisal System",
    "Enabled": true
  },
  "FileTransfer": {
    "Inbound": {
      "FileSource": "Sftp",
      "Sftp": {
        "Host": "#{AS400_SFTP_HOST}#",
        "Port": 22,
        "Username": "#{AS400_SFTP_USERNAME}#",
        "Password": "#{AS400_SFTP_PASSWORD}#"
      }
    },
    "Outbound": {
      "FileSource": "Sftp",
      "Sftp": {
        "Host": "#{AS400_SFTP_HOST}#",
        "Port": 22,
        "Username": "#{AS400_SFTP_USERNAME}#",
        "Password": "#{AS400_SFTP_PASSWORD}#"
      }
    }
  }
}