# .NET Core / ASP.NET Core
# -------------------------------------
bin/
obj/
out/
[Ll]og/

# macOS system files
.DS_Store

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio
.vs/
.vsconfig

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Environment files
.env
.env.*

# NuGet
*.nupkg
*.snupkg
*.nuspec
project.lock.json
project.fragment.lock.json
artifacts/

# Publish output
wwwroot/dist/
wwwroot/node_modules/
node_modules/
dist/
TestResults/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Backup & misc
*.bak
*.old
*.orig
*.swp
*.tmp
*.tmp.*

# Office owner-lock files (Excel/Word/PowerPoint leave these next to an open doc)
~$*

# Database backups
Database/Backups/

# SqlProj publish output
Database/publish/

# Deploy artifact bundles produced by deploy/Publish.ps1
dist-artifacts/

# -------------------------------------
# Docker (keep Dockerfile & docker-compose.yml)
# -------------------------------------
.dockerignore
**/.docker/         # Only ignore custom internal docker folders, not Dockerfile

# Optional: ignore generated Docker volume folders (if any)
docker-volumes/

# -------------------------------------
# Runtime user uploads (local-only; never commit)
# -------------------------------------
Bootstrapper/Api/wwwroot/uploads/documents/
Bootstrapper/Api/wwwroot/uploads/reports/

# -------------------------------------
# File-interface job runtime dirs (side-effects of local Hangfire runs;
# committed sample fixtures inside stay tracked — gitignore only hides new files)
# -------------------------------------
Bootstrapper/Api/outbound/
Bootstrapper/Api/reappraisal/

# Python bytecode (docs/reappraisal data generators)
__pycache__/

# Security-review patch bundles (redundant with the actual commits)
docs/security-review/*.patch

# -------------------------------------
# Local Claude artifacts (local-only)
# -------------------------------------
.claude/worktrees/
.claude/docs/

# -------------------------------------
# AS400 file-interface working folders
# -------------------------------------
# integration.FileInterfaceConfigs points the jobs at these paths, resolved against the app's
# content root. They hold REAL bank data — inbound collateral-link files and the outbound
# COLLATERAL_RESULT / REGULATORY files — so nothing in them may ever reach git. Only committed
# samples belong in docs/, and those are hand-made, never a copy of a production file.
#
# ANCHORED TO THE CONTENT ROOT, NOT **/. A bare **/hostlink/ also matched the SOURCE folders
# Modules/Integration/Integration/FileInterface/Jobs/HostLink and Tests/Unit/Collateral.Tests/HostLink
# — ignore matching is case-insensitive wherever core.ignorecase is on, which is the default on macOS
# and Windows — and silently swallowed three source files, one of which the build needs. Name the
# runtime directories exactly, the way the older reappraisal/outbound rules above already do.
Bootstrapper/Api/hostlink/
Bootstrapper/Api/reappraisal/inbox/
Bootstrapper/Api/reappraisal/processed/
Bootstrapper/Api/outbound/

# -------------------------------------
# Row-level extracts and bank workbooks
# -------------------------------------
# Same rule as the working folders above, applied to docs/: the aggregate .md reports are the
# committed artefact, never the rows behind them. These workbooks are dumps of the U3
# (production-like) database and the bank's own comparison figures.
docs/host-collateral-link/*.xlsx
~$*

# POC mocks belong to whichever feature branch picks them up, not to the shared history.
docs/poc/
